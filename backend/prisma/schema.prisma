// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  date        DateTime
  imageUrl    String
  description String
  ticketUrl   String?
  // Overrides where "Learn More" / "View Details" link to, instead of the internal event page.
  customUrl   String?

  // Multi-day events: when the (single) occurrence finishes. Null = same-day event.
  endDate DateTime?

  // Recurring events: null frequency = one-off. When set, `date`/`endDate` describe the
  // first occurrence and every later occurrence repeats that duration.
  recurrenceFrequency RecurrenceFrequency?
  recurrenceInterval  Int? // every N days/weeks/months; null when not recurring
  recurrenceEndDate   DateTime? // last day repeats may fall on; null = open-ended

  likes EventLike[]
}

// One row per (event, visitor). Visitors are anonymous — `clientId` is a random id the
// browser generates and keeps, so it dedupes honest double-taps rather than proving identity.
model EventLike {
  id        Int      @id @default(autoincrement())
  eventId   Int
  clientId  String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, clientId])
  @@index([eventId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  pinned    Boolean  @default(false)
  imageUrl  String?
  createdAt DateTime @default(now())
}

// A flagship event's own marketing page at /<slug>/, with a home-carousel slide and
// a ticket page. Content is admin-managed; `released`/`featuredOnHome` are flipped at
// runtime (the frontend is a static export, so these can't be build-time flags —
// visitors read them live, same reasoning the old SiteSettings singleton used).
model FlagshipEvent {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  name        String
  tagline     String
  description String

  /** 'save-the-date' | 'booking' — validated in the controller, not the DB. */
  phase String

  /** Shown on the home page hero carousel. */
  featuredOnHome Boolean @default(false)
  /** Page is public. Off = hidden from visitors; admins can still preview it. */
  released       Boolean @default(false)

  /** TryBooking event URL. Empty until booking opens. */
  ticketUrl String @default("")
  /** TryBooking event id (`data-eid`) for the booking widget. Empty until set. */
  ticketEventId String @default("")

  start     DateTime
  end       DateTime
  dateLabel String
  timeLabel String

  /** { name, address, mapUrl, notes: string[], image?: {src,alt,width,height} } */
  venue Json
  /** { src, alt, width, height, mobile?: {src,width,height} } */
  banner Json
  /** 1200x630 image used for link previews. */
  ogImage String
  /** { dark, onDark, light, onLight, primary, onPrimary, accent, hero: {...} } */
  theme Json

  /** { title, body }[] */
  highlights Json @default("[]")
  /** { name, title, topic?, image }[] */
  speakers   Json @default("[]")
  speakerPlaceholderCount Int @default(0)
  /** { time, title, detail? }[] */
  programme  Json @default("[]")
  /** { question, answer }[] */
  faqs       Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
