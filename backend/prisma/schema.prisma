// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  date        DateTime
  imageUrl    String
  description String
  ticketUrl   String

  likes EventLike[]
}

// One row per (event, visitor). Visitors are anonymous — `clientId` is a random id the
// browser generates and keeps, so it dedupes honest double-taps rather than proving identity.
model EventLike {
  id        Int      @id @default(autoincrement())
  eventId   Int
  clientId  String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, clientId])
  @@index([eventId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  pinned    Boolean  @default(false)
  imageUrl  String?
  createdAt DateTime @default(now())
}
