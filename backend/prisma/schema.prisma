// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  date        DateTime
  imageUrl    String
  description String
  ticketUrl   String?

  // Multi-day events: when the (single) occurrence finishes. Null = same-day event.
  endDate DateTime?

  // Recurring events: null frequency = one-off. When set, `date`/`endDate` describe the
  // first occurrence and every later occurrence repeats that duration.
  recurrenceFrequency RecurrenceFrequency?
  recurrenceInterval  Int? // every N days/weeks/months; null when not recurring
  recurrenceEndDate   DateTime? // last day repeats may fall on; null = open-ended
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  pinned    Boolean  @default(false)
  imageUrl  String?
  createdAt DateTime @default(now())
}
