# Backend environment. Copy to .env and fill in — never commit the filled file.
# On Hostinger this file lives in the Node.js app directory and is NOT shipped
# in backend-deploy.zip, so a deploy never overwrites the server's own values.

# ── Required: the app refuses to start without these ──────────────────────
# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Publishable (anon) key. SUPABASE_ANON_KEY is accepted as a fallback name.
SUPABASE_PUBLISHABLE_KEY=
# Postgres connection string. Use Supabase's transaction-mode pooler (IPv4).
DATABASE_URL=

# ── Optional: features degrade without these ─────────────────────────────
# Service-role key. Needed for admin image uploads to Supabase Storage
# (bypasses bucket RLS); without it uploads fall back to the anon client.
SUPABASE_SECRET_KEY=
# Contact + sponsorship forms. Both must be set or those endpoints 500.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
# /api/weather. Without it the weather endpoint returns an error.
WEATHER_API_KEY=
# Port to listen on. Defaults to 3001; Hostinger injects its own PORT.
PORT=

# ── Testing only — leave unset in production ─────────────────────────────
# MOCK_EXTERNALS=1 stubs Aladhan/Weather/Resend for e2e runs.
# MOCK_EXTERNALS=
# ALLOW_DESTRUCTIVE_DB_RESET gates the e2e seed's table wipe.
# ALLOW_DESTRUCTIVE_DB_RESET=
